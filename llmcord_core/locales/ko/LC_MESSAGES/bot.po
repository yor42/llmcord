#: llmcord_core/catchup.py
msgid "Nothing new here since you last spoke."
msgstr "마지막으로 말한 뒤로 새 대화가 없어요."

#: llmcord_core/catchup.py
msgid "Nothing new here in the last hour."
msgstr "지난 1시간 동안 새 대화가 없어요."

#: llmcord_core/catchup.py
#, python-brace-format
msgid "Nothing new here in the last {hours} hours."
msgstr "지난 {hours}시간 동안 새 대화가 없어요."

#: llmcord_core/discord_bot.py
msgctxt "space kind"
msgid "world"
msgstr "월드"

#: llmcord_core/discord_bot.py
msgctxt "space kind"
msgid "hub"
msgstr "허브"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgctxt "space ref"
msgid "{kind} {name}"
msgstr "{name} {kind}"

#: llmcord_core/discord_bot.py
msgid "An admin can find details in the dashboard under Monitoring → Log."
msgstr "관리자는 대시보드의 모니터링 → 로그에서 자세한 내용을 볼 수 있어요."

#: llmcord_core/discord_bot.py
msgid "An admin can find details in the bot log."
msgstr "관리자는 봇 로그에서 자세한 내용을 볼 수 있어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "internal error. {pointer}"
msgstr "내부 오류가 발생했어요. {pointer}"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Your turn failed during {stage} (ref {ref}): {detail}"
msgstr "{stage} 단계에서 턴 처리에 실패했어요 (참조 {ref}): {detail}"

#: llmcord_core/discord_bot.py
msgid "The bot's model setup needs attention. An admin can look it up with the reference ID."
msgstr "봇의 모델 설정을 확인해야 해요. 관리자가 참조 ID로 찾아볼 수 있어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "⏳ {phase} · {model} · 24h tracked: {tokens:,} tokens (+{unreported} unreported calls)"
msgstr "⏳ {phase} · {model} · 24시간 집계: {tokens:,} 토큰 (+미보고 호출 {unreported}건)"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "⏳ {phase} · {model} · 24h tracked: {tokens:,} tokens"
msgstr "⏳ {phase} · {model} · 24시간 집계: {tokens:,} 토큰"

#: llmcord_core/discord_bot.py
msgid "Use this command in a server channel."
msgstr "서버 채널에서 이 명령어를 사용해 주세요."

#: llmcord_core/discord_bot.py
msgid "/catchup works only in character channels on this server. A server admin can allow it in other channels under Server settings in the dashboard."
msgstr "이 서버에서는 /catchup을 캐릭터 채널에서만 쓸 수 있어요. 서버 관리자가 대시보드의 서버 설정에서 다른 채널에도 허용할 수 있어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Created {space} (#{ident})."
msgstr "{space:을/를} 만들었어요 (#{ident})."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "#{ident} {kind}: {name} (off duty)"
msgstr "#{ident} {kind}: {name} (휴식 모드)"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "#{ident} {kind}: {name}"
msgstr "#{ident} {kind}: {name}"

#: llmcord_core/discord_bot.py
msgid "No worlds or hubs yet."
msgstr "아직 월드나 허브가 없어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "{channel} is already bound to {target}; its cast and ambient setting were kept."
msgstr "{channel:은/는} 이미 {target}에 지정되어 있어요. 출연진과 자율 참여 설정은 그대로 유지했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Bound {channel} to {target}. Removed from its cast (not available there): {names}."
msgstr "{channel:을/를} {target}에 지정했어요. 그곳에서 쓸 수 없는 캐릭터를 출연진에서 뺐어요: {names}."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Bound {channel} to {target}. Its cast and ambient setting were kept."
msgstr "{channel:을/를} {target}에 지정했어요. 출연진과 자율 참여 설정은 그대로 유지했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Bound {channel} to {target}."
msgstr "{channel:을/를} {target}에 지정했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Linked {world} to {hub}."
msgstr "{world:을/를} {hub}에 연결했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "{world} is no longer linked to {hub}; removed {count} cast entry."
msgid_plural "{world} is no longer linked to {hub}; removed {count} cast entries."
msgstr[0] "{world:과/와} {hub}의 연결을 해제했어요. 출연진 항목 {count}개를 뺐어요."

#: llmcord_core/discord_bot.py
msgid "in character"
msgstr "캐릭터 유지"

#: llmcord_core/discord_bot.py
msgid "off duty"
msgstr "휴식 모드"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Hub {hub} tone: {tone}."
msgstr "허브 {hub}의 분위기: {tone}."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Imported {name} (#{ident}) into {home} with {count} lore entries."
msgstr "{home}에 {name} (#{ident}) 캐릭터를 가져왔어요. 로어 항목 {count}개도 함께 가져왔어요."

#: llmcord_core/discord_bot.py
msgid "No characters available."
msgstr "사용할 수 있는 캐릭터가 없어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "{name} — home world: {world}"
msgstr "{name} — 홈 월드: {world}"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Active cast: {names}"
msgstr "현재 출연진: {names}"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Added {name} to the active cast."
msgstr "현재 출연진에 {name:을/를} 추가했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Removed {name} from the active cast."
msgstr "현재 출연진에서 {name:을/를} 뺐어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Also dropped {count} character no longer available here."
msgid_plural "Also dropped {count} characters no longer available here."
msgstr[0] "여기서 더 이상 사용할 수 없는 캐릭터 {count}명도 뺐어요."

#: llmcord_core/discord_bot.py
msgid "The active cast is empty. Use /cast set to choose one."
msgstr "현재 출연진이 비어 있어요. /cast set으로 출연진을 골라 주세요."

#: llmcord_core/discord_bot.py
msgid "Channel default cast updated."
msgstr "채널 기본 출연진을 업데이트했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Ambient is on for {channel}."
msgstr "{channel}에서 자율 참여를 켰어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Ambient is off for {channel}."
msgstr "{channel}에서 자율 참여를 껐어요."

#: llmcord_core/discord_bot.py
msgid "Character replies"
msgstr "캐릭터 응답"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "{subject} are paused: this bot reached its spending limit for this period. They resume on {date} (UTC), or sooner if an operator raises the limit."
msgstr "{subject:이/가} 일시 중지되었어요. 이 봇이 이번 기간의 지출 한도에 도달했어요. {date} (UTC)에 다시 시작되며, 운영자가 한도를 올리면 더 빨리 재개돼요."

#. i18n: {hard_cap} is either "off" or a dollar amount
#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Spending warning: this bot has spent {spent} since {period}, past the soft cap of {soft_cap}. Hard cap: {hard_cap}. The period resets on {resets} (UTC)."
msgstr "지출 경고: 이 봇이 소프트 한도({soft_cap})를 넘었어요. {period} 이후 지출: {spent}. 하드 한도: {hard_cap}. 기간은 {resets} (UTC)에 초기화돼요."

#: llmcord_core/discord_bot.py
msgid "off"
msgstr "꺼짐"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Spending limit reached: this bot has spent {spent} since {period}, at or past the hard cap of {hard_cap}. Character replies, ambient turns, catch-ups and memory updates are paused until {resets} (UTC) or until an operator raises the cap in the dashboard's Bot settings."
msgstr "지출 한도 도달: 이 봇이 하드 한도({hard_cap})에 도달했어요. {period} 이후 지출: {spent}. 캐릭터 응답, 자율 참여 턴, 놓친 대화 요약, 기억 업데이트가 {resets} (UTC)까지, 또는 운영자가 대시보드의 봇 설정에서 한도를 올릴 때까지 일시 중지돼요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "{count} model call without a cost estimate was counted as $0."
msgid_plural "{count} model calls without a cost estimate were counted as $0."
msgstr[0] "비용 추정치가 없는 모델 호출 {count}건을 $0으로 계산했어요."

#: llmcord_core/discord_bot.py
msgid "Only the characters seated at this table can speak in its thread."
msgstr "이 테이블에 앉은 캐릭터만 이 스레드에서 말할 수 있어요."

#: llmcord_core/discord_bot.py
msgid "The table's characters aren't talking right now (table talk is off or today's limit is reached)."
msgstr "지금은 테이블의 캐릭터들이 대화하지 않아요 (잡담이 꺼져 있거나 오늘 한도에 도달했어요)."

#: llmcord_core/discord_bot.py
msgid "You can't read this channel's message history, so I can't summarize it."
msgstr "이 채널의 메시지 기록을 읽을 권한이 없어서 요약할 수 없어요."

#: llmcord_core/discord_bot.py
msgid "Catch-ups"
msgstr "놓친 대화 요약"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "You can use /catchup here again in {minutes} minute."
msgid_plural "You can use /catchup here again in {minutes} minutes."
msgstr[0] "{minutes}분 뒤에 여기서 /catchup을 다시 사용할 수 있어요."

#: llmcord_core/discord_bot.py
msgid "I can't read this channel's message history."
msgstr "이 채널의 메시지 기록을 읽을 수 없어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Could not write the catch-up: {detail} (ref {ref})"
msgstr "놓친 대화 요약을 작성할 수 없어요: {detail} (참조 {ref})"

#: llmcord_core/discord_bot.py
msgid "The model returned nothing. Try again later."
msgstr "모델이 아무것도 반환하지 않았어요. 나중에 다시 시도해 주세요."

#: llmcord_core/discord_bot.py
msgid "Personal memory enabled. Use /memory list or /memory opt_out anytime."
msgstr "개인 기억을 켰어요. 언제든지 /memory list 또는 /memory opt_out을 사용할 수 있어요."

#: llmcord_core/discord_bot.py
msgid "Personal memory disabled and your saved personal facts erased."
msgstr "개인 기억을 껐고 저장된 개인 기억을 모두 지웠어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "#{ident} {name}: {content}"
msgstr "#{ident} {name}: {content}"

#: llmcord_core/discord_bot.py
msgid "Unknown"
msgstr "알 수 없음"

#: llmcord_core/discord_bot.py
msgid "No personal memories saved."
msgstr "저장된 개인 기억이 없어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Memory #{memory_id} removed."
msgstr "기억 #{memory_id:을/를} 삭제했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "No memory #{memory_id} of yours was found."
msgstr "내 기억 #{memory_id:을/를} 찾을 수 없어요."

#: llmcord_core/discord_bot.py
msgid "Unknown timezone. Pick one from the list, such as Asia/Seoul."
msgstr "알 수 없는 시간대예요. 목록에서 골라 주세요 (예: Asia/Seoul)."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Your timezone here is now {zone}. Local time: {time}."
msgstr "이곳의 내 시간대를 {zone:으로/로} 설정했어요. 현지 시각: {time}."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Your timezone here is {zone} (your setting). Local time: {time}."
msgstr "이곳의 내 시간대: {zone} (내 설정). 현지 시각: {time}."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Your timezone here is {zone} (server default). Local time: {time}. Use /time set to choose your own."
msgstr "이곳의 내 시간대: {zone} (서버 기본값). 현지 시각: {time}. 직접 고르려면 /time set을 사용해 주세요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Your timezone here is UTC (no timezone set). Local time: {time}. Use /time set to choose yours."
msgstr "이곳의 내 시간대: UTC (설정된 시간대 없음). 현지 시각: {time}. 직접 고르려면 /time set을 사용해 주세요."

#: llmcord_core/discord_bot.py
msgid "You had no timezone set here."
msgstr "이곳에 설정된 내 시간대가 없어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Cleared your timezone. Characters now use {zone} (server default)."
msgstr "내 시간대 설정을 지웠어요. 이제 캐릭터는 서버 기본 시간대인 {zone:을/를} 사용해요."

#: llmcord_core/discord_bot.py
msgid "Cleared your timezone. Characters now use UTC (no timezone set)."
msgstr "내 시간대 설정을 지웠어요. 이제 캐릭터는 UTC를 사용해요 (설정된 시간대 없음)."

#: llmcord_core/discord_bot.py
msgid "Choose a member or a character, not both."
msgstr "멤버나 캐릭터 중 하나만 골라 주세요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "{who} has {amount:,} {currency}."
msgstr "{who}의 잔액은 {amount:,} {currency:이에요/예요}."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "You have {amount:,} {currency}."
msgstr "내 잔액은 {amount:,} {currency:이에요/예요}."

#: llmcord_core/discord_bot.py
msgid "Daily check-ins are off on this server."
msgstr "이 서버에서는 일일 출석 체크가 꺼져 있어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "You already checked in today. Next check-in {reset}."
msgstr "오늘은 이미 출석 체크했어요. 다음 출석 체크: {reset}."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Checked in: +{payout:,} {currency} (day {streak} streak). Balance: {balance:,} {currency}. Next check-in {reset}."
msgstr "출석 체크 완료: +{payout:,} {currency} ({streak}일 연속). 잔액: {balance:,} {currency}. 다음 출석 체크: {reset}."

#: llmcord_core/discord_bot.py
msgid "The daily check-in settings were changed elsewhere. Run the command again."
msgstr "일일 출석 체크 설정이 다른 곳에서 변경되었어요. 명령어를 다시 실행해 주세요."

#: llmcord_core/discord_bot.py
msgid "Daily check-ins are now off."
msgstr "이제 일일 출석 체크가 꺼졌어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Daily check-in: {amount:,} {currency}, no streak bonus."
msgstr "일일 출석 체크: {amount:,} {currency}, 연속 출석 보너스 없음."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Daily check-in: {amount:,} {currency}, +{bonus:,} per streak day for up to {days:,} days."
msgstr "일일 출석 체크: {amount:,} {currency}, 연속 출석 하루마다 +{bonus:,} (최대 {days:,}일)."

#: llmcord_core/discord_bot.py
msgid "Bots cannot hold a balance."
msgstr "봇은 잔액을 가질 수 없어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Gave {amount:,} {currency} to {member}. New balance: {balance:,} {currency}."
msgstr "{member}에게 {amount:,} {currency:을/를} 지급했어요. 새 잔액: {balance:,} {currency}."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Took {amount:,} {currency} from {member}. New balance: {balance:,} {currency}."
msgstr "{member}에게서 {amount:,} {currency:을/를} 회수했어요. 새 잔액: {balance:,} {currency}."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "This server's currency is now called {name}."
msgstr "이 서버의 화폐 이름을 {name:으로/로} 바꿨어요."

#: llmcord_core/discord_bot.py
msgctxt "lore scope"
msgid "channel"
msgstr "채널"

#: llmcord_core/discord_bot.py
msgctxt "lore scope"
msgid "world or hub"
msgstr "월드 또는 허브"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Added {label} lore #{ident}."
msgstr "{label} 로어 #{ident:을/를} 추가했어요."

#: llmcord_core/discord_bot.py
msgctxt "lore scope"
msgid "thread"
msgstr "스레드"

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "#{ident} [{scope}] {content}"
msgstr "#{ident} [{scope}] {content}"

#: llmcord_core/discord_bot.py
msgid "No lore for this channel or its world or hub yet."
msgstr "이 채널이나 연결된 월드 또는 허브에 아직 로어가 없어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Pinned lore #{lore_id}."
msgstr "로어 #{lore_id:을/를} 고정했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Updated lore #{lore_id}."
msgstr "로어 #{lore_id:을/를} 수정했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Promoted lore #{lore_id} to {where} as lore #{ident}."
msgstr "로어 #{lore_id:을/를} {where:으로/로} 승격했어요 (새 로어 #{ident})."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Deleted lore #{lore_id}."
msgstr "로어 #{lore_id:을/를} 삭제했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "No lore #{lore_id} in this server."
msgstr "이 서버에 로어 #{lore_id:이/가} 없어요."

#: llmcord_core/discord_bot.py
msgid "Scene reset. Your next mention or summon starts fresh."
msgstr "장면을 초기화했어요. 다음 멘션이나 소환부터 새로 시작해요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Deleted {count} stored messages from this scene."
msgstr "이 장면에서 저장된 메시지 {count}개를 삭제했어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Also forgot {personal} personal fact and {encounters} encounter."
msgstr "개인 기억 {personal}개와 만남 기록 {encounters}개도 지웠어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Also forgot {personal} personal fact and {encounters} encounters."
msgstr "개인 기억 {personal}개와 만남 기록 {encounters}개도 지웠어요."

#: llmcord_core/discord_bot.py
#, python-brace-format
msgid "Also forgot {personal} personal facts and {encounters} encounter."
msgstr "개인 기억 {personal}개와 만남 기록 {encounters}개도 지웠어요."

#: llmcord_core/discord_bot.py
