#: llmcord_core/i18n/codes.py
msgid "This avatar changed in another tab. Reload the page and try again."
msgstr "이 아바타가 다른 탭에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Use a stable lowercase key, a label up to 80 characters, and a description up to 500 characters."
msgstr "고정된 소문자 키, 80자 이하의 라벨, 500자 이하의 설명을 사용해 주세요."

#: llmcord_core/i18n/codes.py
msgid "That avatar no longer exists. Reload the page."
msgstr "그 아바타는 더 이상 없어요. 페이지를 새로고침해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Every character keeps a neutral image; it cannot be removed."
msgstr "모든 캐릭터는 기본 표정 이미지를 가지고 있어서 삭제할 수 없어요."

#: llmcord_core/i18n/codes.py
msgid "That character is not available in this world or hub."
msgstr "그 캐릭터는 이 월드 또는 허브에서 사용할 수 없어요."

#: llmcord_core/i18n/codes.py
msgid "The archived favorites setting was changed elsewhere. Reload the page and try again."
msgstr "보관된 즐겨찾기 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "A cast can have at most {limit} characters."
msgstr "출연진은 최대 {limit}명까지 지정할 수 있어요."

#: llmcord_core/i18n/codes.py
msgid "The cast limits were changed elsewhere. Reload the page and try again."
msgstr "출연진 제한이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The limits must be whole numbers from 1 to {limit}."
msgstr "제한 값은 1부터 {limit}까지의 정수여야 해요."

#: llmcord_core/i18n/codes.py
msgid "Bind that channel to a world or hub in this server first."
msgstr "먼저 그 채널을 이 서버의 월드 또는 허브에 지정해 주세요."

#: llmcord_core/i18n/codes.py
msgid "That channel belongs to another server."
msgstr "그 채널은 다른 서버에 속해 있어요."

#: llmcord_core/i18n/codes.py
msgid "This channel is not bound to a world or hub."
msgstr "이 채널은 월드 또는 허브에 지정되어 있지 않아요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "That character is at a {noun} table. Try again when the round is over."
msgstr "그 캐릭터는 {noun} 테이블에 앉아 있어요. 라운드가 끝나면 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Character changed; reload before archiving"
msgstr "캐릭터가 변경됐어요. 보관하기 전에 새로고침해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Character changed; reload before deleting"
msgstr "캐릭터가 변경됐어요. 삭제하기 전에 새로고침해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Character changed; reload before saving the fallback avatar"
msgstr "캐릭터가 변경됐어요. 기본 아바타를 저장하기 전에 새로고침해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Character changed; reload before restoring"
msgstr "캐릭터가 변경됐어요. 복원하기 전에 새로고침해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Character changed; reload before saving"
msgstr "캐릭터가 변경됐어요. 저장하기 전에 새로고침해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Choose a home world in this server."
msgstr "이 서버의 홈 월드를 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Character name cannot be empty. Enter a name."
msgstr "캐릭터 이름은 비워 둘 수 없어요. 이름을 입력해 주세요."

#: llmcord_core/i18n/codes.py
msgid "This character name already exists. Choose another name."
msgstr "이미 있는 캐릭터 이름이에요. 다른 이름을 정해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Character not found in this server."
msgstr "이 서버에서 캐릭터를 찾을 수 없어요."

#: llmcord_core/i18n/codes.py
msgid "That entry was already reversed."
msgstr "그 내역은 이미 취소됐어요."

#: llmcord_core/i18n/codes.py
msgid "The amount must be a positive whole number."
msgstr "금액은 양의 정수여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The amount must be a whole number from 1 to {limit:,}."
msgstr "금액은 1부터 {limit:,}까지의 정수여야 해요."

#: llmcord_core/i18n/codes.py
msgid "That character was deleted, so this entry cannot be reversed."
msgstr "그 캐릭터가 삭제되어 이 내역을 취소할 수 없어요."

#: llmcord_core/i18n/codes.py
msgid "That character is not on this server."
msgstr "그 캐릭터는 이 서버에 없어요."

#: llmcord_core/i18n/codes.py
msgid "The daily check-in settings were changed elsewhere. Reload the page and try again."
msgstr "출석 체크 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The daily amount must be a whole number from 0 to {limit:,}."
msgstr "하루 지급액은 0부터 {limit:,}까지의 정수여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The daily streak bonus must be a whole number from 0 to {limit:,}."
msgstr "연속 출석 보너스는 0부터 {limit:,}까지의 정수여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The daily streak days must be a whole number from 0 to {limit:,}."
msgstr "연속 출석 일수는 0부터 {limit:,}까지의 정수여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "That would take {name} above the maximum balance of {limit:,} {currency}."
msgstr "그러면 {name}의 잔액이 최대 잔액 {limit:,} {currency:을/를} 넘어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "That would take <@{user_id}> above the maximum balance of {limit:,} {name}."
msgstr "그러면 <@{user_id}>님의 잔액이 최대 잔액 {limit:,} {name:을/를} 넘어요."

#: llmcord_core/i18n/codes.py
msgid "The currency name was changed elsewhere. Reload the page and try again."
msgstr "화폐 이름이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The currency name must be 1 to 32 characters on one line."
msgstr "화폐 이름은 한 줄로 1~32자여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "That would leave {name} with a negative balance (current balance: {current:,} {currency})."
msgstr "그러면 {name}의 잔액이 음수가 돼요 (현재 잔액: {current:,} {currency})."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "That would leave <@{user_id}> with a negative balance (current balance: {current:,} {name})."
msgstr "그러면 <@{user_id}>님의 잔액이 음수가 돼요 (현재 잔액: {current:,} {name})."

#: llmcord_core/i18n/codes.py
msgid "No such ledger entry on this server."
msgstr "이 서버에 그런 거래 내역이 없어요."

#: llmcord_core/i18n/codes.py
msgid "The reason must be 1 to 200 characters."
msgstr "사유는 1~200자여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The refill cap must be a whole number from 0 to {limit:,}."
msgstr "충전 한도는 0부터 {limit:,}까지의 정수여야 해요."

#: llmcord_core/i18n/codes.py
msgid "The character refill cap was changed elsewhere. Reload the page and try again."
msgstr "캐릭터 충전 한도가 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "A reversal cannot be reversed."
msgstr "취소 기록은 다시 취소할 수 없어요."

#: llmcord_core/i18n/codes.py
msgid "That character is already one of your favorites."
msgstr "그 캐릭터는 이미 즐겨찾기에 있어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "You can have at most {limit} favorites. Remove one first."
msgstr "즐겨찾기는 최대 {limit}명까지예요. 먼저 하나를 빼 주세요."

#: llmcord_core/i18n/codes.py
msgid "Choose \"lean\" or \"step in\" for your favorites."
msgstr "즐겨찾기 모드는 \"우선 응답\" 또는 \"끼어들기\" 중에서 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "That character is not available in this server. Choose another character."
msgstr "그 캐릭터는 이 서버에서 사용할 수 없어요. 다른 캐릭터를 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "You already have a seat in this round."
msgstr "이번 라운드에 이미 자리가 있어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The bet limits must satisfy 1 <= minimum <= maximum <= {limit:,}."
msgstr "베팅 한도는 1 <= 최소 <= 최대 <= {limit:,} 조건을 만족해야 해요."

#: llmcord_core/i18n/codes.py
msgid "The bet limits must be whole numbers."
msgstr "베팅 한도는 정수여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The bet must be between {min_bet:,} and {max_bet:,} {name}."
msgstr "베팅은 {min_bet:,}~{max_bet:,} {name} 사이여야 해요."

#: llmcord_core/i18n/codes.py
msgid "The bet must be a whole number."
msgstr "베팅은 정수여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The buy-in must be between {low:,} and {high:,} {name}."
msgstr "바이인은 {low:,}~{high:,} {name} 사이여야 해요."

#: llmcord_core/i18n/codes.py
msgid "The buy-in must be a whole number."
msgstr "바이인은 정수여야 해요."

#: llmcord_core/i18n/codes.py
msgid "That player cannot move here."
msgstr "그 플레이어는 여기서 행동할 수 없어요."

#: llmcord_core/i18n/codes.py
msgid "Game channels must be Discord channel IDs."
msgstr "게임 채널은 Discord 채널 ID여야 해요."

#: llmcord_core/i18n/codes.py
msgid "Games are not turned on in this channel. Ask an admin to turn them on."
msgstr "이 채널에서는 게임이 켜져 있지 않아요. 관리자에게 켜 달라고 요청해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The game channels were changed elsewhere. Reload the page and try again."
msgstr "게임 채널이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "One of those characters cannot sit at this table."
msgstr "그 캐릭터 중 하나는 이 테이블에 앉을 수 없어요."

#: llmcord_core/i18n/codes.py
msgid "Characters can only join a table in a world or hub channel."
msgstr "캐릭터는 월드 또는 허브 채널의 테이블에만 참가할 수 있어요."

#: llmcord_core/i18n/codes.py
msgid "House seats are only for I Doubt It and Texas Hold'em."
msgstr "하우스 좌석은 다우트와 텍사스 홀덤에서만 쓸 수 있어요."

#: llmcord_core/i18n/codes.py
msgid "That is not a legal move."
msgstr "규칙상 할 수 없는 행동이에요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "You need {cost:,} {name} for insurance but have {have:,}."
msgstr "인슈어런스에 {cost:,} {name:이/가} 필요한데 {have:,}만 있어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{name} seats at most {max_seats} players."
msgstr "{name:은/는} 최대 {max_seats}명까지 앉을 수 있어요."

#: llmcord_core/i18n/codes.py
msgid "Only members can take a seat for now."
msgstr "지금은 멤버만 자리에 앉을 수 있어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{name} needs at least {min_seats} players."
msgstr "{name:은/는} 최소 {min_seats}명이 필요해요."

#: llmcord_core/i18n/codes.py
msgid "The character moves setting was changed elsewhere. Reload the page and try again."
msgstr "캐릭터 행동 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Character moves must be model or style only."
msgstr "캐릭터 행동 방식은 모델 또는 스타일만 가능해요."

#: llmcord_core/i18n/codes.py
msgid "Every player needs chips to play a hand."
msgstr "한 판을 하려면 모든 플레이어에게 칩이 있어야 해요."

#: llmcord_core/i18n/codes.py
msgid "No such game round on this server."
msgstr "이 서버에 그런 게임 라운드가 없어요."

#: llmcord_core/i18n/codes.py
msgid "That table has no rounds."
msgstr "그 테이블에는 라운드가 없어요."

#: llmcord_core/i18n/codes.py
msgid "No such seat."
msgstr "그런 자리가 없어요."

#: llmcord_core/i18n/codes.py
msgid "No such game table on this server."
msgstr "이 서버에 그런 게임 테이블이 없어요."

#: llmcord_core/i18n/codes.py
msgid "Nobody has joined this round yet."
msgstr "아직 이 라운드에 참가한 사람이 없어요."

#: llmcord_core/i18n/codes.py
msgid "That is not a Discord id."
msgstr "Discord ID가 아니에요."

#: llmcord_core/i18n/codes.py
msgid "This round is not being played."
msgstr "이 라운드는 진행 중이 아니에요."

#: llmcord_core/i18n/codes.py
msgid "You do not have a seat in this round."
msgstr "이번 라운드에 자리가 없어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{name} is off on this server."
msgstr "이 서버에서는 {name:이/가} 꺼져 있어요."

#: llmcord_core/i18n/codes.py
msgid "Only the member who opened the table can fill seats."
msgstr "테이블을 연 멤버만 자리를 채울 수 있어요."

#: llmcord_core/i18n/codes.py
msgid "This round could not be restored. Ask an admin to cancel it."
msgstr "이 라운드를 복원할 수 없어요. 관리자에게 취소해 달라고 요청해 주세요."

#: llmcord_core/i18n/codes.py
msgid "This round has already started."
msgstr "이번 라운드는 이미 시작됐어요."

#: llmcord_core/i18n/codes.py
msgid "The current round is still unfinished."
msgstr "현재 라운드가 아직 끝나지 않았어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The {noun} rules were changed elsewhere. Reload the page and try again."
msgstr "{noun} 규칙이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "The {noun} setting was changed elsewhere. Reload the page and try again."
msgstr "{noun} 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The read moves from chat setting was changed elsewhere. Reload the page and try again."
msgstr "채팅에서 행동 읽기 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The read doubts from chat setting was changed elsewhere. Reload the page and try again."
msgstr "채팅에서 다우트 읽기 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The decision-model check setting was changed elsewhere. Reload the page and try again."
msgstr "채팅으로 입력한 행동의 외부 모델 재확인 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The keep phrases setting was changed elsewhere. Reload the page and try again."
msgstr "문장 보관 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The game settings were changed elsewhere. Reload the page and try again."
msgstr "게임 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "You need {stake:,} {name} for that ante but have {balance:,}."
msgstr "그 판돈에 {stake:,} {name:이/가} 필요한데 {balance:,}만 있어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "You need {stake:,} {name} for that buy-in but have {balance:,}."
msgstr "그 바이인에 {stake:,} {name:이/가} 필요한데 {balance:,}만 있어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "You need {stake:,} {name} for that bet but have {balance:,}."
msgstr "그 베팅에 {stake:,} {name:이/가} 필요한데 {balance:,}만 있어요."

#: llmcord_core/i18n/codes.py
msgid "The summary rounds setting was changed elsewhere. Reload the page and try again."
msgstr "요약 라운드 수 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The number of summary rounds must be a whole number from 1 to 20."
msgstr "요약 라운드 수는 1부터 20까지의 정수여야 해요."

#: llmcord_core/i18n/codes.py
msgid "That table is closed."
msgstr "그 테이블은 닫혔어요."

#: llmcord_core/i18n/codes.py
msgid "There is already a table open in this channel."
msgstr "이 채널에는 이미 열린 테이블이 있어요."

#: llmcord_core/i18n/codes.py
msgid "The table is full."
msgstr "테이블이 꽉 찼어요."

#: llmcord_core/i18n/codes.py
msgid "The table moved on. Look at the latest message and try again."
msgstr "테이블 상황이 바뀌었어요. 최신 메시지를 확인하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The character table talk setting was changed elsewhere. Reload the page and try again."
msgstr "캐릭터 잡담 설정이 다른 곳에서 변경됐어요. 페이지를 새로고침하고 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The table talk daily limit was changed elsewhere. Reload the page and try again."
