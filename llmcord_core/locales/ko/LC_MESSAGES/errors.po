#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{where}: placeholder {{{name}}} is not allowed"
msgstr "{where}: 플레이스홀더 {{{name}}}은(는) 사용할 수 없어요"

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{where}: {detail}"
msgstr "{where}: {detail}"

#: llmcord_core/i18n/codes.py
msgid "template: expected text, or an object with text, fields and footer_note"
msgstr "template: 텍스트이거나 text, fields, footer_note가 있는 객체여야 해요"

#: llmcord_core/i18n/codes.py
msgid "template.fields: expected a list of at most 6"
msgstr "template.fields: 최대 6개 항목의 목록이어야 해요"

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "template.fields[{index}]: expected [name, value]"
msgstr "template.fields[{index}]: [name, value] 형식이어야 해요"

#: llmcord_core/i18n/codes.py
msgid "tables: at least one table is required"
msgstr "tables: 테이블이 하나 이상 필요해요"

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{where}: locales mix plain and record rows or differ in fields"
msgstr "{where}: 로캘마다 일반 행과 레코드 행이 섞여 있거나 필드가 달라요"

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{where}.{loc}: expected a list of up to {limit} entries"
msgstr "{where}.{loc}: 최대 {limit}개 항목의 목록이어야 해요"

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{where}.{loc}: expected a list of 1 to {limit} entries"
msgstr "{where}.{loc}: 항목 1~{limit}개의 목록이어야 해요"

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "more than {limit} entries after additions"
msgstr "추가 후 항목이 {limit}개를 넘어요"

#: llmcord_core/i18n/codes.py
msgid "That is not a Texas Hold'em table."
msgstr "텍사스 홀덤 테이블이 아니에요."

#: llmcord_core/i18n/codes.py
msgid "The rebuy must be a whole number above zero."
msgstr "리바이 금액은 0보다 큰 정수여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "A stack can hold at most {high:,} {name}; you can add {room:,}."
msgstr "스택에는 최대 {high:,} {name}까지 담을 수 있어요. {room:,}만큼 더 추가할 수 있어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "You need {amount:,} {name} for that rebuy but have {balance:,}."
msgstr "리바이에는 {amount:,} {name:이/가} 필요하지만 {balance:,}만 있어요."

#: llmcord_core/i18n/codes.py
msgid "Only the member who opened the table can change Assist."
msgstr "테이블을 연 멤버만 어시스트를 바꿀 수 있어요."

#: llmcord_core/i18n/codes.py
msgid "Assist is not allowed on this server."
msgstr "이 서버에서는 어시스트를 사용할 수 없어요."

#: llmcord_core/i18n/codes.py
msgid "No model is set up for this bot. Choose one on the Backend tab."
msgstr "이 봇에 설정된 모델이 없어요. 백엔드 탭에서 모델을 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "That character cannot join this world or hub."
msgstr "그 캐릭터는 이 월드 또는 허브에 참여할 수 없어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "Give a {noun} name."
msgstr "{noun} 이름을 입력해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "Several {plural} match {wanted}: {names}. Use the exact name."
msgstr "{wanted}에 해당하는 {plural:이/가} 여러 개예요: {names}. 정확한 이름을 사용해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "No {noun} named {wanted}."
msgstr "이름이 {wanted}인 {noun:이/가} 없어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "No {noun} named {wanted} in this server."
msgstr "이 서버에 이름이 {wanted}인 {noun:이/가} 없어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "No {noun} named {wanted} available here."
msgstr "여기서 사용할 수 있는 {noun} 중에 이름이 {wanted}인 것이 없어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "No {noun} named {wanted} available here or in the cast."
msgstr "여기나 출연진에서 사용할 수 있는 {noun} 중에 이름이 {wanted}인 것이 없어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "No {noun} named {wanted}{where}."
msgstr "이름이 {wanted}{where}인 {noun:이/가} 없어요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{name} is a {actual}, not a {kind}."
msgstr "{name:은/는} {kind:이/가} 아니라 {actual:이에요/예요}."

#: llmcord_core/i18n/codes.py
msgid "Expected a version 1 llmcord preset. Upload a preset exported from llmcord."
msgstr "버전 1 llmcord 프리셋이 필요해요. llmcord에서 내보낸 프리셋을 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Invalid preset purposes or source metadata. Fix them and try again."
msgstr "프리셋 용도 또는 원본 메타데이터가 올바르지 않아요. 수정한 뒤 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Preset exceeds 8 MiB. Upload a smaller file."
msgstr "프리셋이 8 MiB를 넘어요. 더 작은 파일을 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "A purpose can contain at most 200 blocks."
msgstr "한 용도에는 블록을 최대 200개까지 넣을 수 있어요."

#: llmcord_core/i18n/codes.py
msgid "Invalid prompt block fields. Fix this block and try again."
msgstr "프롬프트 블록 필드가 올바르지 않아요. 이 블록을 수정한 뒤 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Prompt block needs an ID and name."
msgstr "프롬프트 블록에는 ID와 이름이 필요해요."

#: llmcord_core/i18n/codes.py
msgid "Prompt IDs must be nonempty and unique within a purpose. Rename the duplicates."
msgstr "프롬프트 ID는 비어 있으면 안 되고 한 용도 안에서 고유해야 해요. 중복된 ID를 바꿔 주세요."

#: llmcord_core/i18n/codes.py
msgid "Invalid prompt block values. Fix this block and try again."
msgstr "프롬프트 블록 값이 올바르지 않아요. 이 블록을 수정한 뒤 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Invalid role, placement or provider adaptation. Choose a listed option for each block."
msgstr "역할, 배치 또는 제공업체별 배치 방식이 올바르지 않아요. 블록마다 목록에 있는 옵션을 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Depth, order and trimming priority must be whole numbers. Fix them and try again."
msgstr "깊이, 순서, 잘라내기 우선순위는 정수여야 해요. 수정한 뒤 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{purpose} needs exactly one enabled {required} input marker."
msgstr "{purpose}에는 활성화된 {required} 입력 마커가 정확히 하나 있어야 해요."

#: llmcord_core/i18n/codes.py
msgid "Prompt block is too large. Shorten its text."
msgstr "프롬프트 블록이 너무 커요. 텍스트를 줄여 주세요."

#: llmcord_core/i18n/codes.py
msgid "Required prompt inputs exceed the model context budget. Shorten them or use a model with a larger context."
msgstr "필수 프롬프트 입력이 모델의 컨텍스트 예산을 넘어요. 입력을 줄이거나 컨텍스트가 더 큰 모델을 사용해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Upload a native llmcord or SillyTavern Chat Completion preset."
msgstr "llmcord 기본 프리셋이나 SillyTavern Chat Completion 프리셋을 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Invalid prompt order or too many prompt blocks. Remove unused blocks from the file."
msgstr "프롬프트 순서가 올바르지 않거나 프롬프트 블록이 너무 많아요. 파일에서 사용하지 않는 블록을 제거해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Choose a prompt order profile."
msgstr "프롬프트 순서 프로필을 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Invalid or duplicate SillyTavern prompt identifiers. Make each identifier unique."
msgstr "SillyTavern 프롬프트 식별자가 올바르지 않거나 중복돼요. 식별자를 각각 고유하게 만들어 주세요."

#: llmcord_core/i18n/codes.py
msgid "Invalid prompt order entries. Choose a different order profile."
msgstr "프롬프트 순서 항목이 올바르지 않아요. 다른 순서 프로필을 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Duplicate prompt in order profile. Choose a different order profile."
msgstr "순서 프로필에 중복된 프롬프트가 있어요. 다른 순서 프로필을 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Omitted blocks must be a list of block IDs."
msgstr "제외할 블록은 블록 ID 목록이어야 해요."

#: llmcord_core/i18n/codes.py
msgid "Multiple blocks map to the same SillyTavern identifier. Explicitly omit a duplicate."
msgstr "여러 블록이 같은 SillyTavern 식별자에 대응돼요. 중복된 블록 하나를 명시적으로 제외해 주세요."

#: llmcord_core/i18n/codes.py
msgid "World Info wrappers differ. Use the same wrapper or explicitly omit one block for SillyTavern export."
msgstr "World Info 래퍼가 서로 달라요. SillyTavern으로 내보내려면 같은 래퍼를 쓰거나 블록 하나를 명시적으로 제외해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "Explicitly omit nonportable blocks before export: {blocks}."
msgstr "내보내기 전에 다른 곳에서 쓸 수 없는 블록을 명시적으로 제외해 주세요: {blocks}."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "Entry {uid} has no text content. Add text or remove the entry."
msgstr "항목 {uid}에 텍스트 내용이 없어요. 텍스트를 추가하거나 항목을 삭제해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Rule must be an object."
msgstr "규칙은 객체여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "Unknown effective rule fields: {fields}."
msgstr "알 수 없는 유효 규칙 필드: {fields}."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{key} must be true or false."
msgstr "{key} 값은 true 또는 false여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{key} must be an integer."
msgstr "{key} 값은 정수여야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{key} must be a list of strings."
msgstr "{key} 값은 문자열 목록이어야 해요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{key} cannot be negative."
msgstr "{key} 값은 음수일 수 없어요."

#: llmcord_core/i18n/codes.py
msgid "Scan depth must be a nonnegative integer or null."
msgstr "스캔 깊이는 0 이상의 정수이거나 null이어야 해요."

#: llmcord_core/i18n/codes.py
msgid "Regex enabled must be true, false or null."
msgstr "정규식 사용 여부는 true, false 또는 null이어야 해요."

#: llmcord_core/i18n/codes.py
msgid "Probability must be 0 to 100 and secondary matching logic 0 to 3. Fix these values and try again."
msgstr "확률은 0~100, 보조 매칭 로직은 0~3이어야 해요. 이 값들을 수정한 뒤 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Message role must be system, user or assistant. Choose one of these."
msgstr "메시지 역할은 system, user, assistant 중 하나여야 해요. 이 중에서 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Original import must be an object."
msgstr "원본 가져오기 데이터는 객체여야 해요."

#: llmcord_core/i18n/codes.py
msgid "Lorebook exceeds 8 MiB. Upload a smaller file."
msgstr "로어북이 8 MiB를 넘어요. 더 작은 파일을 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Only RisuAI version-1 lorebook exports are supported."
msgstr "RisuAI 버전 1 로어북 내보내기 파일만 지원해요."

#: llmcord_core/i18n/codes.py
msgid "RisuAI lorebook data must be an entry array."
msgstr "RisuAI 로어북 데이터는 항목 배열이어야 해요."

#: llmcord_core/i18n/codes.py
msgid "Expected an entry array, an object with entries, or a RisuAI version-1 lorebook export."
msgstr "항목 배열, 항목이 든 객체, 또는 RisuAI 버전 1 로어북 내보내기 파일이어야 해요."

#: llmcord_core/i18n/codes.py
msgid "Lorebook has too many entries. Split it into smaller books."
msgstr "로어북 항목이 너무 많아요. 더 작은 로어북으로 나눠 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "Invalid or duplicate lorebook entry {uid}."
msgstr "로어북 항목 {uid:이/가} 올바르지 않거나 중복이에요."

#: llmcord_core/i18n/codes.py
msgid "Not a PNG file. Upload a V2/V3 PNG or JSON card."
msgstr "PNG 파일이 아니에요. V2/V3 PNG 또는 JSON 카드를 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The PNG card is corrupt. Export it again and upload the new copy."
msgstr "PNG 카드가 손상됐어요. 다시 내보낸 뒤 새 파일을 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "No character data found in that PNG. Upload a V2/V3 PNG or JSON card."
msgstr "그 PNG에서 캐릭터 데이터를 찾지 못했어요. V2/V3 PNG 또는 JSON 카드를 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Card exceeds 8 MiB. Upload a smaller file."
msgstr "카드가 8 MiB를 넘어요. 더 작은 파일을 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Upload a V2/V3 PNG or JSON card."
msgstr "V2/V3 PNG 또는 JSON 카드를 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Card must contain a JSON object. Upload a V2/V3 PNG or JSON card."
msgstr "카드에 JSON 객체가 있어야 해요. V2/V3 PNG 또는 JSON 카드를 업로드해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "Unsupported character card spec: {spec}. Upload a V2/V3 card."
msgstr "지원하지 않는 캐릭터 카드 규격이에요: {spec}. V2/V3 카드를 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Card has no character name. Add one and upload it again."
msgstr "카드에 캐릭터 이름이 없어요. 이름을 넣고 다시 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Character name exceeds 80 characters. Shorten it and upload again."
msgstr "캐릭터 이름이 80자를 넘어요. 줄인 뒤 다시 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The card repeats a lore entry ID. Remove the duplicate and upload again."
msgstr "카드에 같은 로어 항목 ID가 두 번 있어요. 중복을 지우고 다시 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Avatar exceeds 8 MiB. Upload a smaller image."
msgstr "아바타가 8 MiB를 넘어요. 더 작은 이미지를 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Upload a static PNG, JPEG or WebP image."
msgstr "움직이지 않는 PNG, JPEG 또는 WebP 이미지를 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Avatar exceeds 16 megapixels. Upload a smaller image."
msgstr "아바타가 1600만 화소를 넘어요. 더 작은 이미지를 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "That avatar image is invalid. Upload a PNG, JPEG or WebP image."
msgstr "그 아바타 이미지는 올바르지 않아요. PNG, JPEG 또는 WebP 이미지를 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Discord channels are unavailable. Try again in a moment."
msgstr "Discord 채널을 불러올 수 없어요. 잠시 후 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Discord threads are unavailable. Try again in a moment."
msgstr "Discord 스레드를 불러올 수 없어요. 잠시 후 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Choose an asset text channel in this server."
msgstr "이 서버에서 에셋용 텍스트 채널을 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "The asset channel must deny View Channel to @everyone. Change its permissions in Discord, then choose it again."
msgstr "에셋 채널은 @everyone의 채널 보기 권한을 막아야 해요. Discord에서 권한을 바꾼 뒤 다시 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Upload an image for this slot first."
msgstr "먼저 이 감정에 쓸 이미지를 업로드해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Choose an avatar asset channel first."
msgstr "먼저 아바타 에셋 채널을 선택해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Avatar publication failed. Check that the bot can send messages and attach files in the asset channel."
msgstr "아바타를 게시하지 못했어요. 봇이 에셋 채널에서 메시지를 보내고 파일을 첨부할 수 있는지 확인해 주세요."

#: llmcord_core/i18n/codes.py
msgid "Discord returned an unexpected asset URL. Try again."
msgstr "Discord가 예상하지 못한 에셋 URL을 돌려줬어요. 다시 시도해 주세요."

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "{path} must contain a mapping"
msgstr "{path}에는 매핑이 있어야 해요"

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "LLMCORD_OPERATOR_IDS must be comma-separated Discord user IDs; bad entry: {shown}"
msgstr "LLMCORD_OPERATOR_IDS는 쉼표로 구분한 Discord 사용자 ID여야 해요. 잘못된 항목: {shown}"

#: llmcord_core/i18n/codes.py
#, python-brace-format
msgid "LLMCORD_KEY_HOSTS must look like NAME_API_KEY=host[:port]|https://host2,...; entry {number} is invalid"
msgstr "LLMCORD_KEY_HOSTS는 NAME_API_KEY=host[:port]|https://host2,... 형식이어야 해요. {number}번째 항목이 올바르지 않아요"

#: llmcord_core/i18n/codes.py
msgid "Discord token environment variable is missing"
msgstr "Discord 토큰 환경 변수가 없어요"

#: llmcord_core/i18n/codes.py
msgid "Each model role must name a configured profile"
