#: llmcord_core/i18n/terms.py
msgid "**Texas Hold'em in short**"
msgstr ""

#: llmcord_core/i18n/terms.py
msgid "Make the best five-card hand from your two private cards and the five shared cards."
msgstr ""

#: llmcord_core/i18n/terms.py
#, python-brace-format
msgid "• Two seats post forced blinds ({small} and {big}) before each deal."
msgstr ""

#: llmcord_core/i18n/terms.py
msgid "• Betting runs before the flop (three shared cards), then the turn, then the river. Fold, check, call or raise."
msgstr ""

#: llmcord_core/i18n/terms.py
msgid "• Raise at least the size of the last raise. Going all-in for less is allowed."
msgstr ""

#: llmcord_core/i18n/terms.py
msgid "• If everyone else folds, you win the pot without showing. Otherwise the best hand at showdown wins."
msgstr ""

#: llmcord_core/i18n/terms.py
msgid "• A seat that is all-in can only win what it matched; the rest goes to a side pot."
msgstr ""

#: llmcord_core/i18n/terms.py
#, python-brace-format
msgid "• Take longer than {seconds} s and you check, or fold if you can't."
msgstr ""

