**/.git

# Python environments and caches
**/.venv/
**/.venv314/
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]

# Local configuration and credentials; placeholder templates are safe to include
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/config.yaml
**/config.local.yaml
**/config.*.local.yaml
**/.secrets/
**/secrets/
**/.aws/
**/credentials.json
**/credentials.*.json
**/service-account*.json

# Conversation databases, SQLite sidecars, and backups
**/data/
**/backups/
**/*.db
**/*.db-*
**/*.db.*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite.*
**/*.sqlite3
**/*.sqlite3-*
**/*.sqlite3.*

# SSH keys and TLS certificates
**/.ssh/
**/id_rsa*
**/id_ecdsa*
**/id_dsa*
**/id_ed25519*
**/id_xmss*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.crt
**/*.cer

# Local runtime output and editor files
**/.test-artifacts/
**/.nicegui/
**/logs/
**/*.log
**/*.swp
**/*.swo
